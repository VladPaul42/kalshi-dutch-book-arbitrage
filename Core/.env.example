# Copy this file to .env and fill in the paths for your own machine.
#
# This file holds PATHS to credential files, never the credentials themselves.
# The code opens these files at runtime. Keep the key files outside the project
# directory so they can never be committed by accident.

# ---------------------------------------------------------------------------
# Environment switch
# ---------------------------------------------------------------------------
# "demo" or "production". Credentials are NOT shared between environments: demo
# keys only work against demo hosts and production keys only against production
# hosts. Switching this switches the base URL and the credential paths together,
# so the two can never be mismatched.
#
# Demo order books are synthetic and thin, so any liquidity finding from demo is
# meaningless. Use production for real research. The trader defaults to dry mode;
# production is only write-capable when TRADER_DRY_MODE is explicitly disabled.
KALSHI_ENV=demo

# ---------------------------------------------------------------------------
# Credential file paths, per environment
# ---------------------------------------------------------------------------
# The API key ID file should contain just the key ID on one line.
# The private key file should be the unencrypted PEM Kalshi generated for you,
# the one starting with "-----BEGIN".
KALSHI_DEMO_API_KEY_ID_PATH=C:\path\to\your\demo-api-key-id.txt
KALSHI_DEMO_PRIVATE_KEY_PATH=C:\path\to\your\demo-private-key.txt

KALSHI_PROD_API_KEY_ID_PATH=
KALSHI_PROD_PRIVATE_KEY_PATH=

# ---------------------------------------------------------------------------
# Base URLs
# ---------------------------------------------------------------------------
# Defaults are the current recommended dedicated Trade API hosts. Override only
# if the hostnames change again; they have changed before. The older shared hosts
# api.elections.kalshi.com and demo-api.kalshi.co also still work.
KALSHI_DEMO_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2
KALSHI_PROD_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_DEMO_WS_URL=wss://external-api-ws.demo.kalshi.co/trade-api/ws/v2
KALSHI_PROD_WS_URL=wss://external-api-ws.kalshi.com/trade-api/ws/v2

# ---------------------------------------------------------------------------
# Collector
# ---------------------------------------------------------------------------
# GET /events caps limit at 200, and with_nested_markets=true now honours it.
COLLECTOR_PAGE_LIMIT=200
# Be polite: there are thousands of open markets.
COLLECTOR_PAGE_SLEEP_SECONDS=0.3
# Safety stop so a misbehaving cursor cannot loop forever.
COLLECTOR_MAX_PAGES=200

HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=4

# Gzip each snapshot. A full open-events snapshot is roughly 300 MB of JSON, so
# collecting every 10 minutes would be about 43 GB per day uncompressed. Gzip cuts
# that by well over 10x and stores the exact same bytes; the filter reads plain
# .json and .json.gz transparently. Set to false only if you want to eyeball the
# raw JSON in an editor.
COLLECTOR_COMPRESS=true

# GET /events is a public endpoint, so the collector can run without credentials.
# When true, it falls back to unsigned requests if the selected environment has no
# credentials configured, instead of failing. This lets you collect real
# production data before you have generated production keys.
ALLOW_UNSIGNED_PUBLIC_READS=true

# ---------------------------------------------------------------------------
# Filter gates
# ---------------------------------------------------------------------------
# The event's mutually_exclusive flag must be true. This is the whole basis of
# the project, so you almost certainly want to leave this on.
FILTER_REQUIRE_MUTUALLY_EXCLUSIVE=true

# An event needs at least this many markets to have a ladder at all.
FILTER_MIN_MARKETS=2
# And not too many: a 30-leg event is impractical to quote even if it looks good.
FILTER_MAX_MARKETS=20

# Every market in the event must be tradeable. NOTE: the tradeable market status
# is "active", not "open". The status enum has no "open" value at all.
FILTER_REQUIRE_ALL_ACTIVE=true

# At least one of the four full-bundle trades must be executable on every
# leg: price strictly between 0 and 100 cents, and positive resting size.
# 0 and 100 are empty-book sentinels, not tradable quotes. A dead longshot
# does not kill the event if another complete route (e.g. buy YES) is live.
FILTER_REQUIRE_EXECUTABLE_ROUTE=true

# Liquidity floor, applied to every market in the event. Units are contracts.
# Both floors are 0 on purpose: a market passes when volume or open interest
# is present at all (FILTER_LIQUIDITY_MODE=any).
FILTER_MIN_VOLUME_24H=0
FILTER_MIN_OPEN_INTEREST=0
# "any"  = a market passes if EITHER its 24h volume or its open interest clears
#          its floor.
# "all"  = a market must clear BOTH floors.
FILTER_LIQUIDITY_MODE=any

# Close-time window, measured from the EARLIEST close_time among the event's
# markets. Events have no close time of their own; only markets do, and one leg
# closing in three minutes makes the whole ladder untradeable.
FILTER_MIN_MINUTES_TO_CLOSE=15
FILTER_MAX_DAYS_TO_CLOSE=365

# ---------------------------------------------------------------------------
# Scoring / watchlist
# ---------------------------------------------------------------------------
# Lesser cycles score the re-gated universe and write the top N to
# data/watchlist/. A Greater cycle does not score and does not replace the
# watchlist. Events missing any feature cannot enter the watchlist.
WATCHLIST_SIZE=10

# Minutes to wait after a Greater or Lesser cycle's work finishes before the
# next one starts. The clock starts at the end of the work, not at the start.
# CYCLE_INTERVAL_MINUTES is ignored.
CYCLE_IDLE_MINUTES=5

# ---------------------------------------------------------------------------
# Live watchlist trader
# ---------------------------------------------------------------------------
# Safe default: consume live WebSocket prices and log attempts, but never POST.
# Live/dry is deliberately Core-only; the dashboard has no toggle.
TRADER_DRY_MODE=true

# Both thresholds are arbitrary risk-allocation choices, not market facts.
# 5% avoids locking capital in low-yielding deals. $10 per event ticker spreads
# exposure across events. There is deliberately no account-wide portfolio cap.
TRADER_MIN_ANNUALIZED_PCT=5
TRADER_MAX_CAPITAL_PER_EVENT_DOLLARS=10

# Capital for one fresh clip. Must be above 0 and no higher than the event cap.
# Size is whole bundles of unnetted capital, not a fixed contract count.
TRADER_MAX_CAPITAL_PER_SHOT_DOLLARS=2
